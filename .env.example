# Copy this file to .env before adding credentials. Keep .env private.
HF_TOKEN=

# Add deployed Hugging Face Inference Endpoint URLs only for models you created.
# Endpoint URLs are distinct from public model IDs.
HF_IMAGE_AI_ENDPOINT=
HF_IMAGE_AI_MODEL_NAME=capcheck/ai-image-detection
HF_IMAGE_CAPTION_ENDPOINT=
HF_IMAGE_CAPTION_MODEL_NAME=Salesforce/blip-image-captioning-base
HF_AUDIO_DEEPFAKE_ENDPOINT=
HF_AUDIO_DEEPFAKE_MODEL_NAME=Vansh180/deepfake-audio-wav2vec2
HF_ASR_ENDPOINT=
HF_ASR_MODEL_NAME=openai/whisper-base
HF_SUMMARY_MODEL=

INFERENCE_TIMEOUT_SECONDS=45
IMAGE_MAX_MB=12
AUDIO_MAX_MB=24
# Optional absolute path to move the local database elsewhere.
# NEXUS_DATABASE_PATH=
